# ─── SmartPlaza Backend — Production Environment (cPanel) ───────────────────
# Copy this file to .env and fill in the values before deploying to cPanel.
# IMPORTANT: Never commit the real .env to version control.

# Server
NODE_ENV=production
PORT=5001            # cPanel Passenger sets this automatically; change only if needed
HOST=0.0.0.0

# MongoDB Atlas
MONGODB_URI=mongodb://admin:admin123@ac-hatgiff-shard-00-00.wh8hjlb.mongodb.net:27017,ac-hatgiff-shard-00-01.wh8hjlb.mongodb.net:27017,ac-hatgiff-shard-00-02.wh8hjlb.mongodb.net:27017/smartplaza?ssl=true&replicaSet=atlas-cae8hq-shard-0&authSource=admin&appName=Cluster0
# JWT
JWT_SECRET=akashloveskido
JWT_EXPIRE=30d

# Session
SESSION_SECRET=akashloveskido

# CORS — set to your live domain(s)
FRONTEND_URL=https://smartplazabd.com

# SMS (optional)
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=
